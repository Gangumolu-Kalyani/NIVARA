# Copy this file to .env and fill in your local values. Never commit .env.
DB_URL=jdbc:postgresql://localhost:5432/nivara
DB_USERNAME=nivara_app
DB_PASSWORD=
# Signing key for JWT access tokens (HS256): at least 32 random bytes. Required: the app
# will not start without it. For example: openssl rand -base64 48
JWT_SECRET=

# Assistant language model. Leave LLM_PROVIDER unset (placeholder) to run without a model.
# For OpenRouter: LLM_PROVIDER=openrouter and your key below. Use fake patient data only until the
# provider's data terms are approved, and opt out of training in your OpenRouter privacy settings.
LLM_PROVIDER=
OPENROUTER_API_KEY=
# Optional: LLM_MODEL defaults to openrouter/free, LLM_BASE_URL to https://openrouter.ai/api/v1
