# Copy this file to .env and fill in your local values. Never commit .env.
DB_URL=jdbc:postgresql://localhost:5432/nivara
DB_USERNAME=nivara_app
DB_PASSWORD=
# Signing key for JWT access tokens (HS256): at least 32 random bytes. Required: the app
# will not start without it. For example: openssl rand -base64 48
JWT_SECRET=
